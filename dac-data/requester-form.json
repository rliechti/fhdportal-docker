{
    "jsonForms": {
        "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "title": "Requester Form",
            "description": "Data requester form.",
            "properties": {
                "general": {
                    "type": "object",
                    "title": "General Information",
                    "properties": {
                        "first-name": {
                            "type": "string",
                            "title": "First Name",
                            "readOnly": true
                        },
                        "last-name": {
                            "type": "string",
                            "title": "Last Name",
                            "readOnly": true
                        }
                    }
                },
                "attachments": {
                    "type": "array",
                    "title": "Attachments",
                    "description": "Binary document attachments (e.g. signed agreements).",
                    "x-renderer": "attachment-upload-binary",
                    "x-iri": "https://ontology.swisscustodian.ch/schema/Measure",
                    "items": {
                        "type": "object",
                        "title": "Document",
                        "properties": {
                            "id": {
                                "type": "string",
                                "readOnly": true
                            },
                            "meta": {
                                "type": "object",
                                "properties": {
                                    "fileName": {
                                        "type": "string",
                                        "readOnly": true
                                    },
                                    "iri": {
                                        "type": "string",
                                        "readOnly": true
                                    },
                                    "mimeType": {
                                        "type": "string",
                                        "readOnly": true
                                    },
                                    "downloadUrl": {
                                        "type": "string",
                                        "readOnly": true
                                    },
                                    "size": {
                                        "type": "number",
                                        "readOnly": true
                                    },
                                    "creationDate": {
                                        "type": "string",
                                        "readOnly": true
                                    }
                                }
                            }
                        }
                    }
                },
                "measures": {
                    "type": "object",
                    "title": "Measures",
                    "description": "These are all required measures for the selected dataset.",
                    "properties": {
                        "iri": {
                            "type": "string",
                            "title": "IRI",
                            "description": "These are all required measures for the selected dataset.",
                            "format": "data-url",
                            "readOnly": true
                        },
                        "upload-markdown": {
                            "type": "object",
                            "title": "Additional Information",
                            "properties": {
                                "iri": {
                                    "type": "string",
                                    "title": "IRI",
                                    "readOnly": true,
                                    "x-renderer": "hidden"
                                }
                            },
                            "x-renderer": "attachment-upload-markdown"
                        }
                    }
                },
                "processing": {
                    "type": "object",
                    "title": "Processing",
                    "description": "These are all the allowed types of processing for the selected dataset.",
                    "properties": {
                        "iri": {
                            "type": "string",
                            "title": "IRI",
                            "description": "These are all the allowed types of processing for the selected dataset.",
                            "format": "data-url",
                            "readOnly": true
                        },
                        "upload-markdown": {
                            "type": "object",
                            "title": "Additional Information",
                            "properties": {
                                "iri": {
                                    "type": "string",
                                    "title": "IRI",
                                    "readOnly": true,
                                    "x-renderer": "hidden"
                                }
                            },
                            "x-renderer": "attachment-upload-markdown"
                        }
                    }
                },
                "project": {
                    "type": "object",
                    "title": "Project Information",
                    "properties": {
                        "description": {
                            "type": "string",
                            "title": "Description",
                            "description": "A brief overview of your project goals and scope."
                        },
                        "title": {
                            "type": "string",
                            "title": "Title",
                            "description": "The title of your research project."
                        }
                    }
                },
                "purposes": {
                    "type": "object",
                    "title": "Purposes",
                    "description": "Select the purpose that fits your use-case.",
                    "properties": {
                        "iri": {
                            "type": "string",
                            "title": "IRI",
                            "description": "Select the purpose that fits your use-case.",
                            "format": "data-url",
                            "readOnly": true
                        },
                        "upload-markdown": {
                            "type": "object",
                            "title": "Additional Information",
                            "properties": {
                                "iri": {
                                    "type": "string",
                                    "title": "IRI",
                                    "readOnly": true,
                                    "x-renderer": "hidden"
                                }
                            },
                            "x-renderer": "attachment-upload-markdown"
                        }
                    }
                }
            }
        },
        "uiSchema": {
            "type": "VerticalLayout",
            "elements": [
                {
                    "type": "Group",
                    "label": "General Information",
                    "elements": [
                        {
                            "type": "HorizontalLayout",
                            "elements": [
                                {
                                    "type": "Control",
                                    "scope": "#/properties/general/properties/first-name"
                                },
                                {
                                    "type": "Control",
                                    "scope": "#/properties/general/properties/last-name"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Group",
                    "label": "Project Information",
                    "elements": [
                        {
                            "type": "HorizontalLayout",
                            "elements": [
                                {
                                    "type": "Control",
                                    "scope": "#/properties/project/properties/title",
                                    "options": { "multi": true }
                                },
                                {
                                    "type": "Control",
                                    "scope": "#/properties/project/properties/description",
                                    "options": { "multi": true }
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Group",
                    "label": "Measures",
                    "elements": [
                        {
                            "type": "Control",
                            "scope": "#/properties/measures/properties/upload-markdown"
                        }
                    ]
                },
                {
                    "type": "Group",
                    "label": "Attachments",
                    "elements": [
                        {
                            "type": "Control",
                            "scope": "#/properties/attachments"
                        }
                    ]
                }
            ]
        },
        "initialValues": {
            "general": {
                "first-name": "Local",
                "last-name": "Developer"
            },
            "measures": {
                "iri": "https://ontology.swisscustodian.ch/schema/Measure",
                "upload-markdown": {
                    "iri": "https://ontology.swisscustodian.ch/schema/Measure"
                }
            },
            "processing": {
                "iri": "https://ontology.swisscustodian.ch/schema/Processing",
                "upload-markdown": {
                    "iri": "https://ontology.swisscustodian.ch/schema/Processing"
                }
            },
            "project": {},
            "purposes": {
                "iri": "https://ontology.swisscustodian.ch/schema/Purpose",
                "upload-markdown": {
                    "iri": "https://ontology.swisscustodian.ch/schema/Purpose"
                }
            },
            "attachments": [
                {
                    "id": "180a30a1-9d69-416f-a0f2-f05056ced080",
                    "meta": {
                        "creationDate": "2026-01-01T00:00:00Z",
