GOS_DAC_EMAIL="dac-gos@fega.swiss"


KC_DB="postgres"
KC_DB_URL_HOST=$POSTGRES_HOST
KC_DB_URL_DATABASE="keycloak"
KC_DB_PASSWORD=$POSTGRES_PASSWORD
KC_DB_USERNAME=$POSTGRES_USER
KC_DB_SCHEMA="public"
