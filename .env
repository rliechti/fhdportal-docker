KEYCLOAK_REALM="fhdportal"
VITE_KEYCLOAK_URL="${KEYCLOAK_PUBLIC_URL}"
VITE_KEYCLOAK_CLIENT_ID="fhdportal-sp"
KEYCLOAK_URL="keycloak:8080"
KEYCLOAK_ISSUER_URL="${KEYCLOAK_PUBLIC_URL}"
KEYCLOAK_CLIENT_ID="fhdportal-cli"
KEYCLOAK_SECRET=CPRY895ZjwO1AF3f03IndoqTicmHrRjy
# Token validation in the API: KEYCLOAK_ISSUER_URL (above) must equal the URL the browser uses to
# reach Keycloak (VITE_KEYCLOAK_URL), not the internal KEYCLOAK_URL.
# The API requires "aud" to contain KEYCLOAK_CLIENT_ID (fhdportal-cli): the realm adds it
# with the fhdportal-api-audience mapper. Only tokens issued to these clients are accepted
# (dac-cli: the DAC portal, when it sends its decisions).
KEYCLOAK_ALLOWED_AZP="fhdportal-sp,fhdportal-cli,dac-cli"

# Used by bin/fega.phar to download the metadata schemas
FEGA_API_URL="https://fhd-portal.fega.swiss/api/"

# Beacon (GA4GH Beacon v2), served at /api/beacon. Without these the values are
# derived from FEGA_API_URL, which points at the production portal.
BEACON_ID="swiss.fega.fhd-portal"
BEACON_ENVIRONMENT="dev"
BEACON_BASE_URL="${PORTAL_URL}/api/beacon"
BEACON_PORTAL_URL="${PORTAL_URL}/"

# DAC portal client (decisions on access requests)
