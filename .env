# ── Where the demonstrator is reached ──────────────────────────────────────────────────────────────────────────────────────────
# The ONLY lines to change to install it on a server (see docs/install-on-a-server.md, or run scripts/set-public-host.sh).
# Every address below is derived from these. Laptop: leave as it is (HTTP, localhost). A server that other people can reach:
# HTTPS and the real DNS name, for example  PUBLIC_HOST=fhd-demo.example.org  PUBLIC_SCHEME=https  PORTAL_PORT=5174  KEYCLOAK_PORT=8443
PUBLIC_HOST=localhost
# the same name with each dot written [.] (fhd-demo[.]example[.]org): it is used in a regular expression (CORS)
PUBLIC_HOST_REGEX=localhost
PUBLIC_SCHEME=http
# the ports the BROWSER uses: 5173 (HTTP) or 5174 (HTTPS) for the portal, 8080 (HTTP) or 8443 (HTTPS) for Keycloak.
# Behind a reverse proxy on the standard ports, use 443 (or 80) and the proxy's Keycloak port.
PORTAL_PORT=5173
KEYCLOAK_PORT=8080
# Which network interface the OTHER ports (database 5433, API 8082, Keycloak plain HTTP 8080, mock DAC 3000, MailHog 1025/8025) listen on.
# 127.0.0.1 = this machine only (default). 0.0.0.0 = the whole network: only for an HTTP-only test on a trusted network.
INTERNAL_BIND=127.0.0.1
PORTAL_URL="${PUBLIC_SCHEME}://${PUBLIC_HOST}:${PORTAL_PORT}"
KEYCLOAK_PUBLIC_URL="${PUBLIC_SCHEME}://${PUBLIC_HOST}:${KEYCLOAK_PORT}"
# ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# ── Which software is built ────────────────────────────────────────────────────────────────────────────────────────────────────
# The images clone fhdportal-api and fhdportal-app from GitHub when they are built (not when they start).
# *_REF is a branch, a tag or a commit: the default, main, is the tip of the branch on the day of the build. Pin a release for a
# reproducible installation, then rebuild:  docker compose build --no-cache api webserver && docker compose up -d
API_REPO=rliechti/fhdportal-api
APP_REPO=rliechti/fhdportal-app
API_REF=main
APP_REF=main
# ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

APP_ENV=prod
APP_DEBUG=false
APP_SECRET=e697dae5f09768b303b30e66696cd03d

VITE_FEGA_COUNTRY_NAME="Test"
VITE_FEGA_COUNTRY_ADJECTIVE="Test"

POSTGRES_HOST=db
POSTGRES_DB=fhd-portal
POSTGRES_USER=fhd-user
POSTGRES_PASSWORD='X9c5AL2TssiDLHk'
POSTGRES_MULTIPLE_DATABASES="fega,keycloak"

# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
DATABASE_URL="postgresql://postgres@db:5432/fega?serverVersion=16&charset=utf8"

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN="^https?://(localhost|127[.]0[.]0[.]1|${PUBLIC_HOST_REGEX})(:[0-9]+)?$"
###< nelmio/cors-bundle ###

VITE_APP_URL="${PORTAL_URL}"
VITE_API_URL="/api/"
VITE_API_ORIGIN="${PORTAL_URL}"
VITE_ENVIRONMENT="dev"

MAILER_DSN='smtp://mailhog:1025'
NO_REPLY_EMAIL="noreply-staging@fega.swiss"
