SDA_INBOX="/var/www/fhd-portal/sda"

SYMFONY_TRUSTED_HEADERS="X-Forwarded-Prefix"

DAC_API="http://dac-api:3000"

# Disable RabbitMQ
RABBITMQ_ENABLED=false
MQ_HOST="rabbitmq"
MQ_PORT=5672
MQ_VHOST=fega
